# URL de la base de datos. El esquema debe ser "postgresql+psycopg" (driver
# psycopg 3); "postgresql://" a secas intentaría usar psycopg2, que no está
# instalado.
DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/biblioteca
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
